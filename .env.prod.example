# Production environment for docker-compose.prod.yaml.
# Copy to `.env` on the VPS (next to docker-compose.prod.yaml) and fill in.
# NEVER commit the real .env.

# --- API server ---
APP_ENV=production
SERVER_PORT=8080
# SERVER_HOST is forced to 0.0.0.0 by the compose file; do not set it here.
BASE_URL=https://api.your-domain.com
SERVER_RATE_LIMIT_PER_SECOND=100
SERVER_RATE_LIMIT_BURST=200
# CORS: comma-separated origins allowed to call the API from a browser.
ALLOWED_ORIGINS=https://app.your-domain.com

# --- Database (the API reads DB_*; DB_HOST/DB_PORT are set by compose) ---
# These three MUST match the POSTGRES_* values below.
DB_USER=loci
DB_PASSWORD=CHANGE_ME_strong_password
DB_NAME=loci
DB_SSLMODE=disable

# --- Postgres container init (used the first time the volume is created) ---
POSTGRES_USER=loci
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=loci

# --- Auth ---
# NOTE: the app reads JWT_SECRET (not JWT_SECRET_KEY). 32+ random bytes.
JWT_SECRET=CHANGE_ME_32_byte_minimum_random_secret

# Signs refresh tokens. MUST differ from JWT_SECRET: with one shared key an
# access token also verifies as a refresh token, so a leaked short-lived access
# token can be exchanged for a 30-day session. Production refuses to boot when
# these are equal. Generate with: openssl rand -base64 48
JWT_REFRESH_SECRET=CHANGE_ME

# Token lifetimes (Go duration strings). These are now honoured; they used to be
# hardcoded to 1h / 720h regardless of what was set here.
JWT_ACCESS_TOKEN_TTL=1h
JWT_REFRESH_TOKEN_TTL=720h
ADMIN_EMAIL=you@your-domain.com

# --- Two-factor authentication (TOTP) ---
# Encrypts TOTP secrets at rest (AES-256-GCM). MUST be exactly 32 bytes.
# Leave unset to disable MFA entirely — the server will not fall back to storing
# secrets in plaintext. Generate with: openssl rand -hex 16
#
# Rotating this key makes every existing enrolment undecryptable: enrolled users
# can no longer sign in and must be re-enrolled. Treat it as permanent.
MFA_SECRET_KEY=

# Comma-separated roles that cannot turn MFA off, e.g. "admin,owner".
# Empty means MFA is optional for everyone.
MFA_REQUIRED_FOR_ROLE=

# --- Subscription quotas (daily LLM request limits) ---
# Free tier daily limit; Pro's hidden fair-use cap (marketed as unlimited).
FREE_DAILY_LLM_LIMIT=10
PRO_DAILY_LLM_LIMIT=100

# --- Stripe (subscriptions; webhook drives entitlement) ---
STRIPE_API_KEY=sk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_PRICE_ID_MONTHLY=price_CHANGE_ME
STRIPE_PRICE_ID_ANNUAL=price_CHANGE_ME

# --- AI provider (openrouter is the default when AI_PROVIDER is unset) ---
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=CHANGE_ME
OPENROUTER_MODEL=openrouter/auto
# Loci stores 768-dimensional vectors in pgvector.
OPENROUTER_EMBEDDING_MODEL=google/gemini-embedding-001
AI_EMBEDDING_DIMENSION=768
# Per-call LLM deadlines (defaults: 30s non-streaming, 120s streaming).
# AI_GENERATE_TIMEOUT_SEC=30
# AI_STREAM_TIMEOUT_SEC=120

# --- AI fallback chain ---
# Must stay false in production: the fallback models are shared, rate-limited
# free-tier models intended as a local testing floor. Load() refuses to boot
# with this enabled when APP_ENV=production, and also rejects a ":free"
# OPENROUTER_MODEL, so a dev default cannot silently become the prod model.
# When the provider is out of credits in production the request fails loudly
# and the operator is paged, rather than quietly degrading paying users.
AI_FALLBACK_ENABLED=false

# Partner deeplinks (Weekend Compare + booking CTAs)
BOOKING_AFFILIATE_ID=
RESERVE_AFFILIATE_ID=
UBER_CLIENT_ID=
# --- Weather / local context -------------------------------------------------
# PRODUCTION POSTURE: OpenWeather, air quality off.
#
# Open-Meteo's free tier is NON-COMMERCIAL by their terms -- they name "apps
# that have subscriptions" as commercial use, and Loci sells a Pro plan. Their
# Standard plan is EUR 29/month and grants a commercial licence; until there are
# users to justify that, production runs on OpenWeather instead.
#
# The server REFUSES TO BOOT under APP_ENV=production if this is misconfigured,
# because a licence breach is silent -- Open-Meteo keeps answering. See
# deploy/OPS.md.
WEATHER_PROVIDER=openweather

# Required when WEATHER_PROVIDER=openweather.
OPENWEATHER_API_KEY=
# AI_PROVIDER=gemini
# GEMINI_API_KEY=CHANGE_ME
# GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Cache (optional Redis for multi-instance LLM/geo string cache) ---
# Leave REDIS_URL empty for in-memory only (single instance).
# REDIS_URL=redis://redis:6379/0
# CACHE_KEY_PREFIX=loci:
# CACHE_LLM_TTL_SEC=300
# CACHE_GEO_TTL_SEC=1200
# CACHE_CLEANUP_TTL_SEC=600

# --- Observability ---
METRICS_ENABLED=true
METRICS_PORT=9090
PPROF_ENABLED=false

# --- Image overrides (optional; the deploy workflow exports these) ---
# API_IMAGE=ghcr.io/facorreia/loci-connect-api:latest
# POSTGRES_IMAGE=ghcr.io/facorreia/loci-connect-api-postgres:latest

# --- Live trip signals -------------------------------------------------------
# Public-holiday alerts for a destination (hazards and air quality next).
# Every source here is free and keyless; the whole block works unset.
#
# Alerts show up in GetLocalContext, in the trip view's alert list, and as a
# graded penalty on the go-score. SIGNALS_ENABLED=false turns all of it off.
SIGNALS_ENABLED=true
# Several public APIs require an identifying User-Agent and throttle without one.
SIGNALS_USER_AGENT=loci/1.0 (+https://loci.app)
SIGNALS_HTTP_TIMEOUT_SEC=8
SIGNALS_HTTP_MAX_RETRIES=2
# Per-host outbound rate limit, to stay inside free-tier usage policies.
SIGNALS_RATE_LIMIT_PER_SECOND=5
SIGNALS_RATE_LIMIT_BURST=5
# Override only to self-host or to point tests at a fake.
# NAGER_DATE_BASE_URL=https://date.nager.at
# BIGDATACLOUD_BASE_URL=https://api.bigdatacloud.net

# Hazard sources. GDACS is the multi-hazard feed (wildfire, cyclone, flood,
# quake, volcano) and carries its own Green/Orange/Red triage; USGS adds
# locally significant earthquakes GDACS does not rank globally. Overlapping
# reports of one event are deduplicated so the go-score charges it once.
GDACS_ENABLED=true
USGS_ENABLED=true
# How near counts as "near the destination". Generous, because a wildfire or a
# cyclone affects travel well beyond where it is burning; the distance is always
# stated in the alert so a traveller can judge.
HAZARD_RADIUS_KM=500
# GDACS_BASE_URL=https://www.gdacs.org
# USGS_BASE_URL=https://earthquake.usgs.gov
# Air quality. Unlike the hazard feeds this always has a value, so the
# threshold is what keeps it from attaching an alert to every trip. It is the
# European AQI scale: 60 = poor, 80 = very poor, 100+ = extremely poor.
# One alert per trip, naming the worst day, never one per day.
# Air quality follows WEATHER_PROVIDER: openweather uses OpenWeather's air
# pollution API on the same key, anything else uses Open-Meteo. So this can stay
# on in production as long as the forecast provider is licence-clean.
AIR_QUALITY_ENABLED=true
# Band at which to warn: good | fair | moderate | poor | very_poor.
# Provider-neutral, because Open-Meteo reports a 0-100+ European AQI and
# OpenWeather reports its own 1-5 index.
AIR_QUALITY_ALERT_BAND=poor
# OPENMETEO_AIR_QUALITY_BASE_URL=https://air-quality-api.open-meteo.com

# --- Money -------------------------------------------------------------------
# Exchange rates from Frankfurter (ECB reference rates): keyless, ~0.2s, exact.
# The ECB publishes only 30 currencies; anywhere else returns no rate rather
# than a guess, and names the currency it could not price.
FX_ENABLED=true
FX_BASE_CURRENCY=EUR
# FX_BASE_URL=https://api.frankfurter.dev

# Assumptions behind the fuel estimate for a driving leg. Always restated in the
# response so a traveller can correct them against their own car.
FUEL_LITRES_PER_100KM=6.5
FUEL_PRICE_PER_LITRE=1.75

# --- Metric export (optional) -------------------------------------------------
# Push the Prometheus metrics this service already exposes to an OTLP endpoint.
# Unset means no push; /metrics still works for anything that scrapes it.
# PostHog's path is /i/v1/metrics, not the OTLP default /v1/metrics.
# The key is a PostHog project key (phc_...), the same one the web client uses.
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=https://eu.i.posthog.com/i/v1/metrics
# OTEL_EXPORTER_OTLP_METRICS_HEADERS=Authorization=Bearer phc_your_project_key
#
# OTEL_SDK_DISABLED=true switches off tracing and metric export together,
# whatever else is set here.

# --- Server-side product analytics (optional) ---------------------------------
# The same PostHog project key the web client uses, so browser events and
# server events land in one project and can be joined on the user.
# Unset means no server-side events; the metrics push above is independent.
# POSTHOG_API_KEY=phc_your_project_key
# POSTHOG_HOST=https://eu.i.posthog.com
