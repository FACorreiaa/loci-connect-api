# Production environment for docker-compose.prod.yaml.
# Copy to `.env` on the VPS (next to docker-compose.prod.yaml) and fill in.
# NEVER commit the real .env.

# --- API server ---
APP_ENV=production
SERVER_PORT=8080
# SERVER_HOST is forced to 0.0.0.0 by the compose file; do not set it here.
BASE_URL=https://api.your-domain.com
SERVER_RATE_LIMIT_PER_SECOND=100
SERVER_RATE_LIMIT_BURST=200
# CORS: comma-separated origins allowed to call the API from a browser.
ALLOWED_ORIGINS=https://app.your-domain.com

# --- Database (the API reads DB_*; DB_HOST/DB_PORT are set by compose) ---
# These three MUST match the POSTGRES_* values below.
DB_USER=loci
DB_PASSWORD=CHANGE_ME_strong_password
DB_NAME=loci
DB_SSLMODE=disable

# --- Postgres container init (used the first time the volume is created) ---
POSTGRES_USER=loci
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=loci

# --- Auth ---
# NOTE: the app reads JWT_SECRET (not JWT_SECRET_KEY). 32+ random bytes.
JWT_SECRET=CHANGE_ME_32_byte_minimum_random_secret
ADMIN_EMAIL=you@your-domain.com

# --- Subscription quotas (daily LLM request limits) ---
# Free tier daily limit; Pro's hidden fair-use cap (marketed as unlimited).
FREE_DAILY_LLM_LIMIT=10
PRO_DAILY_LLM_LIMIT=300

# --- Gemini (required; the app refuses to start without these) ---
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-flash-lite-latest

# --- Cache (optional Redis for multi-instance LLM/geo string cache) ---
# Leave REDIS_URL empty for in-memory only (single instance).
# REDIS_URL=redis://redis:6379/0
# CACHE_KEY_PREFIX=loci:
# CACHE_LLM_TTL_SEC=300
# CACHE_GEO_TTL_SEC=1200
# CACHE_CLEANUP_TTL_SEC=600

# --- Observability ---
METRICS_ENABLED=true
METRICS_PORT=9090
PPROF_ENABLED=false

# --- Image overrides (optional; the deploy workflow exports these) ---
# API_IMAGE=ghcr.io/facorreia/loci-connect-api:latest
# POSTGRES_IMAGE=ghcr.io/facorreia/loci-connect-api-postgres:latest
