# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
.cache/
# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
vendor/
main
# Go workspace file
go.work
tmp
.env
improve.md
.claude
.loci-connect-api
icons
loci-connect-api
bin
# server binary (anchored to root)
/server
.DS_Store
.posthog-wizard-cache/
*.p8

# --- Build output: never commit a binary. ---
# CI enforces this by file content (.github/workflows/no-binaries.yml); these
# entries keep the usual outputs from ever being staged.
bin/
tmp/
.build/
*.exe
*.test
*.o
*.a
*.so
*.dylib
/air
/api
/bundle-forge
/golangci-lint
/loci-connect-api
/loci-doctor
/loci-mcp
/main
/preference-rerank
/server
/sqlc
/tailwindcss
/telegram-check
/templ
